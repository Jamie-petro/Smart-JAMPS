# Local only. On Vercel, set these in Project Settings → Environment Variables. Never commit .env.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
IMAGE_PROVIDER=gemini        # gemini (Nano Banana) | openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash   # chat, plan review and AI rewrite fall back to Gemini when Claude is unavailable
# Review-tab chat: Claude only (ANTHROPIC_API_KEY), thinking off, max 1024 output tokens per reply.
CHAT_ENABLED=true          # false switches the chat off (it then answers from the plan data, labelled "not AI")
CHAT_LIMIT_PER_HOUR=20     # messages per visitor per hour (soft: per server instance)
CHAT_LIMIT_PER_DAY=300     # messages per day for the whole app (soft: per server instance)
